    private fun build(
        category: String,
        prefix: String,
        starts: List<String>,
        ends: List<String>,
        day: Long
    ): List<Question> {
        val offset = Math.floorMod(day, 10L).toInt()
        return starts.flatMapIndexed { i, start ->
            ends.mapIndexed { j, end ->
                val a = starts[(i + offset) % starts.size]
                val b = ends[(j + offset) % ends.size]
                val text = when (category) {
                    ROMANCE -> "$a $b"
                    CONNAISSANCE -> "$a $b"
                    COPINE -> "$a $b"
                    else -> "$a $b"
                }
                Question("${prefix}_${i}_$j", category, 1, text)
            }
        }
    }

    private fun catalog(category: String, day: Long): List<Question> {
        val result = when (category) {
            ROMANCE -> build(category, "rom", romanceStart, romanceEnd, day)
            CONNAISSANCE -> build(category, "know", knowStart, knowEnd, day)
            COPINE -> build(category, "chat", chatStart, chatEnd, day)
            PHILO -> quotes.flatMapIndexed { i, quote ->
                debates.mapIndexed { j, debate ->
                    Question(
                        "philo_${i}_$j", PHILO, 2,
                        "$quote\n\nSujet à discuter : $debate"
                    )
                }
            }
            else -> emptyList()
        }

        // Les 100 propositions sont réordonnées chaque jour.
        return result.sortedBy {
            Math.floorMod(it.id.hashCode().toLong() * 31L + day * 17L,
                Long.MAX_VALUE)
        }.take(100)
    }

    fun questionsFor(
        category: String,
        day: Long = LocalDate.now().toEpochDay()
    ): List<Question> = catalog(category, day)

    fun dailyQuestions(
        day: Long = LocalDate.now().toEpochDay()
    ): List<Question> = categories.flatMap { catalog(it, day) }

    val all: List<Question>
        get() = dailyQuestions()
